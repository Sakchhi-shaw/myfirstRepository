package java_practical;

import java.util.Arrays;
//Return an array where one number is missing and another number is duplicate
public class TestDemo{

	public  static int[] missingDuplicate(int[] arr) {
		int i=0;
		while(i<arr.length) {
			int correct=arr[i]-1;
			if(arr[i]!=arr[correct]) {
				swap(arr,i,correct);
			}else {
				i++;
			}
		}
		int missing=-1;
		int duplicate=-1;
		for(int j=0;j<arr.length;j++) {
			if(arr[j]-1!=j) {
				 missing=j+1;
				 duplicate=arr[j];
			}
		}
		return new int[]{missing,duplicate};
	}
	public static void swap(int[] arr, int i, int correct) {
		int tmp=arr[i];
		arr[i]=arr[correct];
		arr[correct]=tmp;
			
		}
public static void main(String[] args) {
int[] arr= {2,1,4,2,6,5};
int[] output=missingDuplicate(arr);
System.out.println(Arrays.toString(output));


}

}
