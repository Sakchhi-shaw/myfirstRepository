package java_practical;
public class TestDemo{
public static void reverseColumn(int[][] arr) {
	for(int i=0;i<arr.length;i++) {
		int left=0;
		int right=arr[0].length-1;
		while(left<right) {
			int tmp=arr[i][left];
			arr[i][left]=arr[i][right];
			arr[i][right]=tmp;
			left++;
			right--;
		}
	}
}	
public static void main(String[] args) {
int[][] arr= {{1,6,11,16,21},{2,7,12,17,22},{3,8,13,18,23},{4,9,14,19,24},{5,10,15,24,25}};
System.out.println("Before reversing:/n");
for(int i=0;i<arr.length;i++) {
	for(int j=0;j<arr[0].length;j++) {
		System.out.print(arr[i][j]+" ");
	}
	System.out.println();
}
reverseColumn(arr);
System.out.println("After reversing:/n");
for(int i=0;i<arr.length;i++) {
	for(int j=0;j<arr[0].length;j++) {
		System.out.print(arr[i][j]+" ");
	}
	System.out.println();
}
}

}
