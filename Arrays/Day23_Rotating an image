package java_practical;
public class TestDemo{
public static void rotateAnImage(int[][] arr) {
	//Transpose
for(int i=0;i<arr.length;i++) {
	for(int j=i+1;j<arr[0].length;j++) {
		int tmp=arr[i][j];
		arr[i][j]=arr[j][i];
		arr[j][i]=tmp;
	}
}
//Reversing Columns
for(int i=0;i<arr.length;i++) {
	int left=0;
	int right=arr[0].length-1;
	while(left<right) {
		int tmp=arr[i][left];
		arr[i][left]=arr[i][right];
		arr[i][right]=tmp;
		left++;
		right--;
	}
}
}	
public static void main(String[] args) {
int[][] arr= {{1,2,3},{4,5,6},{7,8,9}};
System.out.println("Before rotating:/n");
for(int i=0;i<arr.length;i++) {
	for(int j=0;j<arr[0].length;j++) {
		System.out.print(arr[i][j]+" ");
	}
	System.out.println();
}
rotateAnImage(arr);
System.out.println("After rotating:/n");
for(int i=0;i<arr.length;i++) {
	for(int j=0;j<arr[0].length;j++) {
		System.out.print(arr[i][j]+" ");
	}
	System.out.println();
}
}

}
