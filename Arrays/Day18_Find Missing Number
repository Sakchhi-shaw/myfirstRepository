package java_practical;

public class Demo{
	public static int cycleSort(int[] arr) {
		int i=0;
		int	n=arr.length;
		while(i<n) {
			int correct=arr[i];
			if(arr[i] <n && arr[i]!=arr[correct]) {
				swap(arr,i,correct);
			}else {
				i++;
			}
			}
		for(int j=0;j<n;j++) {
			if(arr[j]!=j) {
				return j;
			}
		}
	
		return n;
}
		
public static void swap(int[] arr, int i, int correct) {
int tmp=arr[i];
arr[i]=arr[correct];
arr[correct]=tmp;
	
}
public static void main(String[] args) {
	int[] arr= {3,2,4,0};//Range is[0,4]
	int missing=cycleSort(arr);
	System.out.println("The missing number is: " +missing);	
}
}
