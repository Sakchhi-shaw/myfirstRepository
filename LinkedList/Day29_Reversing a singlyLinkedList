package java_practical;

public class testDemo {
	TreeNode head;
	TreeNode tail;
	public void addLast(int data) {
		TreeNode tmp=new TreeNode(data);
		if(head==null) {
			head=tmp;
			tail=tmp;
		}else {
			tail.next=tmp;
			tail=tmp;
		}
	}
	public void addFirst(int data) {
		TreeNode tmp=new TreeNode(data);
		if(head==null) {
			head=tmp;
			tail=tmp;
		}else {
			tmp.next=head;
			head=tmp;
		}
	}
	public void print() {
		TreeNode curr=head;
		while(curr!=null) {
			System.out.print(curr.data + " ");
			curr=curr.next;
		}
	}
	public void reverseIterative() {
		if(head==null|| head.next == null) {
			return;
		}else {		
TreeNode prevNode=null;
TreeNode curr=head;
while(curr!=null) {
	TreeNode nextNode=curr.next;
	curr.next=prevNode;
	prevNode=curr;
	curr=nextNode;
}
head=prevNode;
		}
	}
	public int countNode() {
		TreeNode curr=head;
		int count=0;
		while(curr!=null) {
		count++;
		curr=curr.next;
		}
		return count;
	}
	public static void main(String[] args) {
testDemo t=new testDemo();
t.addLast(10);
t.addLast(20);
t.addLast(30);
t.addLast(40);
t.print();
t.reverseIterative();
System.out.println("\nAfter reversing:\n");
t.print();
System.out.println("\nThe numbers of nodes are:"+t.countNode());
	}

}
